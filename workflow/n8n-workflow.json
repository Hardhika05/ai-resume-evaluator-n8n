      ],
      "id": "3b8a3410-c301-427e-a194-317b9a3acfe1",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "// 1. Get raw streamed output\nconst raw = $input.first().json.data;\n\n// 2. Join all response chunks\nconst text = [...raw.matchAll(/\"response\":\"([^\"]*)\"/g)]\n  .map(m => m[1])\n  .join('')\n  .toLowerCase();\n\n// 3. Extract values safely\nconst scoreMatch = text.match(/\\b(\\d{1,3})\\b/);\nconst shortlistMatch = text.includes('true');\nconst reasonMatch = text\n  .split('reason')\n  .slice(1)\n  .join(' ')\n  .replace(/\\\\n+/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// 4. Return clean structured output\nreturn [\n  {\n    json: {\n      score: scoreMatch ? Number(scoreMatch[1]) : null,\n      shortlist: shortlistMatch,\n      reason: reasonMatch || null\n    }\n  }\n];\n"
      },

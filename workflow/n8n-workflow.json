      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gemma3:1b\",\n  \"prompt\": \"Return ONLY valid JSON: {\\\"score\\\":85,\\\"shortlist\\\":true,\\\"reason\\\":\\\"Test reason\\\"}\"\n}\n",
        "options": {
          "response": {
